PORT=3010
NODE_ENV=production
TZ=Asia/Tehran
PUBLIC_URL=https://news.pnu.ac.ir
TRUST_PROXY=1
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=pnu_news
DB_USER=pnu_news
DB_PASSWORD='CHANGE_ME'
APP_SECRET='CHANGE_ME_64_HEX_CHARS'
UPLOAD_DIR=/workspace/PnuNews/uploads

# خبرگیری پورتال: internal = زمان‌بند داخلی برنامه (پیش‌فرض)، external = با cron/systemd (scripts/fetch-portal-news.sh)
#PORTAL_FETCH_MODE=external

# اکنون‌پخش رادیو: اگر نام دامنهٔ سرور رادیو از دید سرور برنامه به نشانی داخلی (۱۰.x، ۱۹۲.۱۶۸.x) می‌رسد، نام میزبان را اینجا بگذارید (چند نام با کاما)
#RADIO_TRUSTED_HOSTS=radiostream.pnu.ac.ir
