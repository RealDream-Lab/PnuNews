# /etc/systemd/system/pnunews-portal.timer
# فعال‌سازی: systemctl daemon-reload && systemctl enable --now pnunews-portal.timer
[Unit]
Description=PnuNews: fetch portal news every 10 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
